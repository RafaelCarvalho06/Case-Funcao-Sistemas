# Normaliza os finais de linha dos arquivos de texto
* text=auto

# Codigo e scripts (CRLF no Windows)
*.cs      text diff=csharp
*.cshtml  text
*.js      text
*.sql     text
*.md      text
*.csproj  text
*.sln     text eol=crlf

# Banco de dados e binarios: nunca converter
*.mdf binary
*.ldf binary
*.dll binary
*.png binary
*.ico binary
*.zip binary
